---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingCTA from "../components/FloatingCTA.astro";
import { site } from "../data/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = `${site.brand}｜${site.tagline}`,
  description = site.description,
  image = "/og.jpg",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const pageTitle = title.includes(site.brand) ? title : `${title}｜${site.brand}`;

const schema = {
  "@context": "https://schema.org",
  "@type": "PestControlService",
  name: site.brand,
  alternateName: [site.legalName, site.english],
  url: canonical.origin,
  telephone: site.phoneDisplay,
  email: site.email,
  taxID: site.taxId,
  foundingDate: site.founded,
  image: ogImage.href,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.line,
    addressLocality: "板橋區",
    addressRegion: "新北市",
    addressCountry: "TW",
  },
  areaServed: ["台北市", "新北市"],
  openingHours: "Mo-Sa 09:00-21:00",
};
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c0e0d" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Noto+Sans+TC:wght@400;500;600&family=Noto+Serif+TC:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要內容</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <FloatingCTA />
  </body>
</html>
