---
import { Picture } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site, services } from "../../data/site";
import { photos, type PhotoKey } from "../../data/media";
---

<BaseLayout title="服務項目" description="白蟻防治、滅鼠、住家店面除蟲、工地與環境消毒。文盈除蟲勘查後施工。">
  <header class="page-hero wrap">
    <p class="eyebrow">服務</p>
    <h1>先說你看到什麼，再決定怎麼處理。</h1>
  </header>
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="service-grid">
        {
          services.map((item) => {
            const img = photos[item.image as PhotoKey];
            return (
              <a class="service-card" href={`/services/${item.slug}/`}>
                <div class="service-card__media">
                  <Picture src={img} formats={["avif", "webp"]} alt={`${item.title}的作業畫面`} widths={[800, 1400]} sizes="50vw" />
                </div>
                <div class="service-card__body">
                  <span class="image-note">圖像 · 情境示意</span>
                  <p class="eyebrow">{item.kicker}</p>
                  <h3>{item.title}</h3>
                  <p>{item.summary}</p>
                </div>
              </a>
            );
          })
        }
      </div>
      <p class="mute" style="margin-top:2rem; max-width:38rem; line-height:1.85">
        跳蚤、螞蟻、蚊子，算在住家與店面。機關、學校、社區，算在工地與環境消毒。不確定是哪一種，先打 {site.phoneDisplay}。
      </p>
    </div>
  </section>
</BaseLayout>
