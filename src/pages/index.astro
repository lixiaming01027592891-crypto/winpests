---
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, services, process, cases, faqs } from "../data/site";
import { photos, type PhotoKey } from "../data/media";

const featured = cases.slice(0, 6);
---

<BaseLayout>
  <section class="hero">
    <div class="hero__media">
      <Picture
        src={photos.hero}
        formats={["avif", "webp"]}
        alt="工地病媒處理情境示意"
        loading="eager"
        fetchpriority="high"
        widths={[720, 1080, 1600, 2400]}
        sizes="100vw"
      />
      <span class="image-note">情境示意</span>
    </div>
    <div class="hero__copy">
      <p class="eyebrow">新北板橋 · {site.founded} 年設立</p>
      <h1>家裡有蟲，<br />先看它從哪裡來。</h1>
      <p class="hero__lead">
        白蟻、老鼠、蟑螂，或工地開始積水生蚊。打個電話說一下現場，我們再跟你約時間。
      </p>
      <div class="hero__cta">
        <a class="btn btn-solid" href={site.phoneHref}>免付費 {site.phoneDisplay}</a>
        <a class="btn" href={site.lineUrl} target="_blank" rel="noreferrer">用 LINE 說現場</a>
      </div>
    </div>
    <div class="hero__meta">
      <span><b>{site.founded}</b> 設立</span>
      <span><b>{site.taxId}</b> 統編</span>
      <span><b>病媒防治業</b> 登記</span>
      <span><b>環境用藥零售</b></span>
    </div>
  </section>

  <section class="section" id="services">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">服務</p>
          <h2>常見的四種情況</h2>
        </div>
        <p class="mute">
          作法不一樣。白蟻看木頭，老鼠看通道，店面看打烊以後，工地看積水。
        </p>
      </div>
      <div class="service-grid">
        {
          services.map((item) => {
            const img = photos[item.image as PhotoKey];
            return (
              <a class="service-card" href={`/services/${item.slug}/`}>
                <div class="service-card__media">
                  <Picture src={img} formats={["avif", "webp"]} alt={`${item.title}情境示意`} widths={[640, 960, 1400]} sizes="(min-width: 980px) 50vw, 100vw" />
                  <span class="image-note">情境示意</span>
                </div>
                <div class="service-card__body">
                  <p class="eyebrow">{item.kicker}</p>
                  <h3>{item.title}</h3>
                  <p>{item.lead}</p>
                  <span class="btn">看這項怎麼做</span>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section section-light" id="process">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">怎麼配合</p>
          <h2>先看過，才報價</h2>
        </div>
        <p class="mute">白蟻和老鼠尤其是這樣。電話裡能講清楚的，我們也會直說。</p>
      </div>
      <div class="process">
        {
          process.map((step) => (
            <article>
              <b>{step.n}</b>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="cases">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">作業情境</p>
          <h2>常見的作業場域</h2>
        </div>
        <p class="mute">工地、透天、社區地下室、餐飲後場、學校走廊。圖片為情境示意，實際作法依現場勘查。</p>
      </div>
      <div class="case-grid">
        {
          featured.map((item) => {
            const img = photos[item.image as PhotoKey];
            return (
              <a class="case-card" href="/cases/">
                <Picture src={img} formats={["avif", "webp"]} alt={`${item.place}｜${item.title}情境示意`} widths={[640, 1200, 1800]} sizes="50vw" />
                <span class="image-note">情境示意</span>
                <figcaption>
                  <span>{item.place} · {item.service}</span>
                  <h3>{item.title}</h3>
                </figcaption>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section section-light">
    <div class="wrap split">
      <figure>
        <Picture src={photos.equipment} formats={["avif", "webp"]} alt="防治機具與餌站情境示意" widths={[800, 1200]} sizes="50vw" />
        <figcaption class="image-note">情境示意</figcaption>
      </figure>
      <div>
        <p class="eyebrow">登記資料</p>
        <h2>用藥合法，現場可以給你看</h2>
        <p class="mute">
          文盈蟲害防治企業社，負責人{site.owner}，統編 {site.taxId}。做病媒防治和環境用藥零售。施工時你可以要求看出執照和藥名。
        </p>
        <p>
          <a class="btn btn-dark" href="/about/">關於這間社</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section section-light" style="padding-top:0">
    <div class="wrap faq">
      <p class="eyebrow">常見問題</p>
      <h2>常被問到的</h2>
      {
        faqs.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</BaseLayout>
