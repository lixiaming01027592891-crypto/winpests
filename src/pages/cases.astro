---
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { cases } from "../data/site";
import { photos, type PhotoKey } from "../data/media";
---

<BaseLayout title="常見作業情境" description="文盈除蟲常見的工地、住宅白蟻、地下室滅鼠、餐飲與校園作業情境；圖片為情境示意，實際作法依現場勘查。">
  <header class="page-hero wrap">
    <p class="eyebrow">作業情境</p>
    <h1>常見的作業場域</h1>
    <p class="mute">以下圖片為情境示意。每個現場的蟲害來源與處理方式不同，實際作法以勘查結果為準。</p>
  </header>
  <section class="section" style="padding-top:0">
    <div class="wrap scenario-list">
      {
        cases.map((item) => {
          const img = photos[item.image as PhotoKey];
          return (
            <article class="scenario-card" id={item.slug}>
              <figure class="scenario-card__media">
                <Picture src={img} formats={["avif", "webp"]} alt={`${item.place}｜${item.title}`} widths={[800, 1400]} sizes="(min-width: 980px) 48vw, 100vw" />
                <figcaption class="image-note">圖像 · 情境示意</figcaption>
              </figure>
              <div class="scenario-card__body">
                <span>{item.place} · {item.service}</span>
                <h2>{item.title}</h2>
                <p class="mute">{item.text}</p>
                <dl class="scenario-checks">
                  <div>
                    <dt>你可能看到</dt>
                    <dd>{item.signal}</dd>
                  </div>
                  <div>
                    <dt>到場先查</dt>
                    <dd>{item.inspect}</dd>
                  </div>
                  <div>
                    <dt>處理方向</dt>
                    <dd>{item.direction}</dd>
                  </div>
                </dl>
                <a class="btn" href="/contact/#request">說說你的現場</a>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
